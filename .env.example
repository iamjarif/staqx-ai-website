# Public site URL used for metadata, sitemap, and canonical URLs.
# NEXT_PUBLIC_SITE_URL=https://example.com

# Sanity — same project as the live Boston Semiconductor site (published posts only).
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Optional. Only needed if the dataset is private.
# SANITY_API_READ_TOKEN=
